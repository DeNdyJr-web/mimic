{
  "name": "mimic-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MIMIC client (Vite + React + TypeScript). Dev server runs on fixed port 5175.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "gen:keys": "node scripts/gen-translation-keys.mjs",
    "validate:locales": "node scripts/validate-locales.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.10"
  }
}
